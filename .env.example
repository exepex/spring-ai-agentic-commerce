# Copy to .env and fill in. Never commit .env.

# Required for the agents: an Anthropic API key (console.anthropic.com).
AGENTIC_COMMERCE_ANTHROPIC_API_KEY=

# Optional: a Stripe TEST-mode secret key (sk_test_...). Without it, payments are simulated.
AGENTIC_COMMERCE_STRIPE_SECRET_KEY=

# Optional: Slack. A bot token (xoxb-...) with chat:write, channels:read, channels:history, groups:read,
# im:read, mpim:read and users:read, and the id of the channel the bot was invited to.
# Start with: ./start-demo.sh --slack
AGENTIC_COMMERCE_SLACK_BOT_TOKEN=
AGENTIC_COMMERCE_SLACK_CHANNEL_ID=

# Optional: ServiceNow, for the incident agent. A developer instance (developer.servicenow.com) works. The user
# needs the itil role; see README, "ServiceNow incidents", for the groups to create. Leave the URL empty to run without.
AGENTIC_COMMERCE_SERVICENOW_INSTANCE_URL=
AGENTIC_COMMERCE_SERVICENOW_USERNAME=
AGENTIC_COMMERCE_SERVICENOW_PASSWORD=

# Shared secrets between the services. Change them for anything beyond a local demo.
# The password of the commerce database user. Postgres keeps the one it was first started with: to change it later,
# remove the database volume (docker compose down -v), which also removes the data.
AGENTIC_COMMERCE_DATABASE_PASSWORD=commerce
AGENTIC_COMMERCE_SHOPPING_ASSISTANT_TOKEN=dev-shopping-assistant-token
AGENTIC_COMMERCE_INCIDENT_AGENT_TOKEN=dev-incident-agent-token
# What the services present to each other's internal endpoints: placing, cancelling, charging, reserving, refunding.
AGENTIC_COMMERCE_INTERNAL_API_TOKEN=dev-internal-api-token
AGENTIC_COMMERCE_SLACK_MCP_API_KEY=dev-slack-mcp-key
